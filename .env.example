# ---------------------------------------------------------------------------
# Environment variables for the portfolio.
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored, so your values are never committed.
# ---------------------------------------------------------------------------

# Public site URL, used to resolve absolute Open Graph / Twitter image URLs.
# Optional: defaults to the Vercel deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# GitHub username used by the "GitHub Projects" section to fetch public repos.
# Optional: if left unset, the site falls back to `githubUsername` in
# data/social.ts, and if that is still a placeholder it shows a graceful
# fallback state instead of crashing.
GITHUB_USERNAME=

# Optional GitHub personal access token.
# NOT required for public repositories — it only raises the API rate limit.
# Create one at https://github.com/settings/tokens (no scopes needed for
# public data). Never commit a real token.
GITHUB_TOKEN=
